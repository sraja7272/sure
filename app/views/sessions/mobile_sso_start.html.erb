<!DOCTYPE html>
<html><body>
  <form id="sso_form" action="/auth/<%= ERB::Util.html_escape(@provider) %>" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <%# OmniAuth only accepts a POST, so the no-JavaScript fallback has to submit this form rather than link to it. %>
    <noscript><button type="submit"><%= t("sessions.new.submit") %></button></noscript>
  </form>
  <script>document.getElementById('sso_form').submit();</script>
</body></html>
