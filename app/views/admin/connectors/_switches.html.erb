<div id="connector_switches" class="space-y-4">
  <% { "Bank" => t("admin.connectors.show.kinds.bank"), "Investment" => t("admin.connectors.show.kinds.investment"), "Crypto" => t("admin.connectors.show.kinds.crypto") }.each do |kind, title| %>
    <% connectors = @connectors_by_kind[kind] %>
    <% next if connectors.blank? %>

    <%= settings_section title: title do %>
      <div class="divide-y divide-alpha-black-200 theme-dark:divide-alpha-white-200">
        <% connectors.each do |connector| %>
          <div class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
            <label for="connector_<%= connector.key %>" class="font-medium text-primary"><%= connector.name %></label>
            <%= render DS::Toggle.new(
              id: "connector_#{connector.key}",
              name: "connectors[#{connector.key}]",
              checked: @enabled_keys.include?(connector.key),
              data: { action: "change->connector-switches#save" }
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
